## Blink LED0 at 1 Hz on a Nexys A7-100T: divide the 100 MHz clock (pin E3) down.
module nexys_a7_blink for hdl
clock sys: 100 MHz @ pin(E3)

circuit blinker(led: out bit @ pin(H17)) on sys:
  const half_period = 50_000_000
  reg ticks: bit<26> = 0
  reg state: bit = 0
  on rising(sys):
    if ticks == half_period - 1:
      ticks = 0
      state = ~state
    else:
      ticks = ticks + 1
  comb:
    led = state

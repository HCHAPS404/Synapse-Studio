{
  "name": "@synapse/sdk-ts",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "SYNAPSE Core API TypeScript types and a thin typed client, generated from OpenAPI",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "gen": "uv run --project ../../services/core python ../../tools/export-openapi.py",
    "gen:check": "uv run --project ../../services/core python ../../tools/export-openapi.py --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}

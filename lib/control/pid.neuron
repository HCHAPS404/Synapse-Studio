## PID controller with anti-windup.
module std.control.pid for core

## Proportional-integral-derivative controller.
##
## The output is limited to `out_min..out_max`. While the output saturates the
## integral stops growing (anti-windup), so the controller leaves saturation as soon as
## the error changes sign. The class receives `dt` from the caller and keeps no clock.
pub class Pid:
  let kp: f32
  let ki: f32
  let kd: f32
  let out_min: f32
  let out_max: f32
  var integral: f32 = 0.0
  var previous: f32 = 0.0

  ## Computes the output for `error` after `dt` seconds.
  pub fn update(mut self, error: f32, dt: f32) -> f32:
    requires dt > 0.0
    let p = self.kp * error
    let d = self.kd * (error - self.previous) / dt
    self.previous = error
    let raw = p + self.integral + d
    let out = clamp(raw, self.out_min, self.out_max)
    if out == raw:
      self.integral += self.ki * error * dt
    return out

test "pid with only a proportional term":
  var c = Pid(kp: 2.0, ki: 0.0, kd: 0.0, out_min: -100.0, out_max: 100.0)
  assert c.update(3.0, 0.1) == 6.0, "kp * error"
  assert c.update(-4.0, 0.1) == -8.0, "follows the error"

test "pid output stays inside its limits":
  var c = Pid(kp: 10.0, ki: 1.0, kd: 0.0, out_min: 0.0, out_max: 100.0)
  assert c.update(50.0, 0.1) == 100.0, "clamped high"
  assert c.update(-50.0, 0.1) == 0.0, "clamped low"

test "pid stops integrating while saturated":
  var c = Pid(kp: 10.0, ki: 5.0, kd: 0.0, out_min: 0.0, out_max: 100.0)
  for i in 0..20:
    c.update(50.0, 0.1)
  assert c.integral == 0.0, "no windup while saturated"
  assert c.update(-1.0, 0.1) == 0.0, "leaves saturation at once"

test "pid integral accumulates inside the limits":
  var c = Pid(kp: 0.0, ki: 1.0, kd: 0.0, out_min: -100.0, out_max: 100.0)
  assert c.update(2.0, 0.5) == 0.0, "first step has no integral yet"
  assert c.update(2.0, 0.5) == 1.0, "integral after one step"
  assert c.update(2.0, 0.5) == 2.0, "integral after two steps"
